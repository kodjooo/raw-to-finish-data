# JSON ключ сервисного аккаунта Google (IAM → Service Accounts → Keys)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-credentials.json

# Email пользователя Google Workspace для делегирования прав (оставьте пустым, если не нужно)
GOOGLE_DELEGATED_USER=

# ID таблицы-источника (Google Sheet A)
SOURCE_SPREADSHEET_ID=

# Название листа внутри источника
SOURCE_WORKSHEET_NAME=RawProducts

# ID таблицы-приёмника (Google Sheet B)
SINK_SPREADSHEET_ID=

# Название листа приёмника
SINK_WORKSHEET_NAME=BitrixSink

# Таблица справочника брендов (Google Sheet с двумя колонками: ID и название)
BRAND_REGISTRY_SPREADSHEET_ID=
BRAND_REGISTRY_WORKSHEET_NAME=Brands
BRAND_REGISTRY_NAME_COLUMN=brand
BRAND_REGISTRY_ID_COLUMN=brand_id
# Статусы в источнике
SOURCE_STATUS_NEW=Не обработано
SOURCE_STATUS_IN_PROGRESS=
SOURCE_STATUS_DONE=Обработано
SOURCE_STATUS_ERROR=Ошибка

# Колонки источника
SOURCE_STATUS_COLUMN=status
SOURCE_NOTE_COLUMN=note
# Опционально для многопоточности/нескольких воркеров (если не используете — оставьте пустыми)
SOURCE_WORKER_COLUMN=
SOURCE_IN_PROGRESS_AT_COLUMN=
SOURCE_IN_PROGRESS_TTL_SECONDS=
SOURCE_CLAIM_TOKEN_COLUMN=
SOURCE_CONTENT_COLUMN=product_content
SOURCE_CATEGORY_COLUMN=category
SOURCE_IMAGE_COLUMN=image_path
SOURCE_ID_COLUMN=product_id_hash
SOURCE_PROCESSED_AT_COLUMN=processed_at
SOURCE_LLM_RAW_COLUMN=llm_raw

# Идентификатор обработчика (hostname/под)
WORKER_ID=

# Настройки LLM (OpenAI Responses API)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=changeme
# Модель из списка в OpenAI Console → Models
LLM_MODEL=gpt-5-nano-2025-08-07
# Режим рассуждений: none|low|medium|high (если не задан, отключён)
LLM_REASONING_EFFORT=none
# Путь к файлу системного промпта (см. config/system_prompt.txt)
LLM_SYSTEM_PROMPT_PATH=./config/system_prompt.txt
# Путь к файлу пользовательского промпта (см. config/user_prompt.txt)
LLM_USER_PROMPT_PATH=./config/user_prompt.txt
LLM_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=3

# Ограничения пайплайна
BATCH_SIZE=20
MAX_RPS=2
MAX_RPM=60

# Пути до конфигов
CONFIG_PATH=./config/config.yaml
MAPPING_PATH=./config/mapping.yaml
